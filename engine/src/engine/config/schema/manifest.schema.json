{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "language", "profiles",
    "sources", "scan", "ocr", "structure", "edition", "prompt_context"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "source_noise", "typeface"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "source_noise": {"type": "string", "minLength": 1},
        "typeface": {"type": "string", "minLength": 1}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {"type": "object"},
        "source_noise": {"type": "object"},
        "typeface": {"type": "object"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "label", "ia_item_id"],
        "properties": {
          "role": {"type": "string"},
          "label": {"type": "string"},
          "ia_item_id": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "page_image_template", "leaf_offset", "last_scan_page_default"],
      "properties": {
        "pdf": {"type": "string"},
        "page_image_template": {"type": "string"},
        "leaf_offset": {"type": "integer"},
        "last_scan_page_default": {"type": "integer"}
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flash", "pro"],
          "properties": {
            "flash": {"type": "string", "minLength": 1},
            "pro": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h2_min", "h3_count", "parts", "content_units",
        "retention_min", "foreign_char_max", "word_quality_high_severity_max",
        "running_heads"
      ],
      "properties": {
        "h2_min": {"type": "integer", "minimum": 0},
        "h3_count": {"type": "integer", "minimum": 0},
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "chapters"],
            "properties": {
              "name": {"type": "string"},
              "chapters": {"type": "integer", "minimum": 0}
            }
          }
        },
        "content_units": {"type": "integer", "minimum": 0},
        "retention_min": {"type": "number", "minimum": 0, "maximum": 1},
        "foreign_char_max": {"type": "number", "minimum": 0, "maximum": 1},
        "word_quality_high_severity_max": {"type": "integer", "minimum": 0},
        "running_heads": {"type": "array", "items": {"type": "string"}}
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_it", "subtitle_it", "subtitle_en", "author", "year",
        "colophon", "ia_item_id", "site_base"
      ],
      "properties": {
        "title_it": {"type": "string"},
        "subtitle_it": {"type": "string"},
        "subtitle_en": {"type": "string"},
        "author": {"type": "string"},
        "year": {"type": "integer"},
        "colophon": {"type": "string"},
        "ia_item_id": {"type": "string"},
        "site_base": {"type": "string"}
      }
    },
    "prompt_context": {
      "type": "object",
      "$comment": "The keys a prompt template consumes are pinned as they gain a consumer. The OCR template (profiles/prompts/ocr.txt.j2) requires book_title/author/year; subject/entities are carried for the later triage/translate prompts and pinned when those land. Left extensible (additionalProperties open) on purpose.",
      "required": ["book_title", "author", "year"],
      "properties": {
        "book_title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "year": {"type": "integer"}
      }
    },
    "segmentation": {
      "type": "object",
      "$comment": "S2.1 segmentation front-end config (DT-5/DT-6/DT-7). OPTIONAL — only a book whose scans go through the geometry/segmentation front-end carries it; the classifiers' constructors enforce the value RANGES (this schema pins only presence + JSON type). density_bands ruled by Ben 2026-07-06 at the S2.1.4 calibration checkpoint (labeled set in review/density_calibration.json); column_detector ruled by Ben 2026-07-06 at the S2.1.5 (#39) run-report checkpoint (evidence in docs/probes/s2_1_column_report.md). The loader reads both to construct the DensityClassifier + ColumnDetector via from_config.",
      "additionalProperties": false,
      "required": ["order_source", "density_bands", "column_detector"],
      "properties": {
        "order_source": {
          "$comment": "DT-5 two-branch reading-order sourcing. 'witness': a column-ordered text witness supplies order, the detector is a QA cross-check (PLL/copy1). 'geometry': the detector is authoritative (image-only sources).",
          "enum": ["witness", "geometry"]
        },
        "density_bands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yield_content_min", "box_content_min", "ink_blank_max", "ink_dark_min",
            "confidence_margin", "cover_edge_leaves", "ink_saturation_min"
          ],
          "properties": {
            "yield_content_min": {"type": "number"},
            "box_content_min": {"type": "integer"},
            "ink_blank_max": {"type": "number"},
            "ink_dark_min": {"type": "number"},
            "confidence_margin": {"type": "number"},
            "cover_edge_leaves": {"type": "integer"},
            "ink_saturation_min": {"type": "number"}
          }
        },
        "column_detector": {
          "$comment": "DT-7 column-decision policy. The classifier's constructor enforces the ranges (both in (0,1)); this schema pins presence + JSON type. Per-book config (numberless core); #40's run-report tooling can auto-propose these from the book's col2_score distribution, human-ratified and frozen here.",
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_threshold", "hysteresis_margin"],
          "properties": {
            "decision_threshold": {"type": "number"},
            "hysteresis_margin": {"type": "number"}
          }
        },
        "review_fraction_max": {
          "$comment": "DT-10 / P-6 (S2.1.6 #40): the per-stage human-review volume bound. OPTIONAL — absent lets the run reach for the ruled default 0.15 (geom_review.REVIEW_FRACTION_MAX_DEFAULT); a book carries it only to tune its own budget. build_worklist enforces the range.",
          "type": "number"
        },
        "geometry_mode": {
          "$comment": "S2.2 (#30) re-gate output: the S5 geometry operating mode ruled from the as-built order_qa breadth feed (geom_regate.regate_verdict). OPTIONAL — a book carries it once the re-gate has run; absent means the mode is unruled (S5 falls back to conditional-primary). Values are the geom_regate MODE_* vocabulary (enum bound to the module by test_geom_regate). PLL landed geometry-tie-break 2026-07-08 (mean 0.842 / pass@0.85 0.779 < the 0.85 bar; docs/probes/s2_2_regate.md).",
          "enum": ["geometry-primary", "geometry-tie-break", "no-geometry"]
        }
      }
    }
  }
}
