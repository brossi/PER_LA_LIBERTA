{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisory structural-content source observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stale_class",
    "book",
    "observer_policy",
    "expectations_sha256",
    "sources",
    "expectations",
    "page_features",
    "sightings",
    "summaries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stale_class": {"const": "structural-contents-observation"},
    "book": {"type": "string", "minLength": 1},
    "observer_policy": {"const": "structural-contents-sightings-v1"},
    "expectations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expectation"}
    },
    "page_features": {
      "type": "array",
      "items": {"$ref": "#/$defs/page_feature"}
    },
    "sightings": {
      "type": "array",
      "items": {"$ref": "#/$defs/sighting"}
    },
    "summaries": {
      "type": "array",
      "items": {"$ref": "#/$defs/summary"}
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "fraction": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "format",
        "source_ref",
        "sha256",
        "bytes",
        "lines",
        "interpretation"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "format": {"enum": ["djvu-xml", "plain-text"]},
        "source_ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "lines": {"$ref": "#/$defs/nonnegative_integer"},
        "interpretation": {"const": "observed"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation_id", "literal", "role", "normalized"],
      "properties": {
        "expectation_id": {"$ref": "#/$defs/source_id"},
        "literal": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1}
      }
    },
    "page_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "page",
        "nonempty_lines",
        "trailing_page_reference_lines",
        "trailing_page_references",
        "comparable_adjacent_references",
        "nondecreasing_adjacent_references",
        "nondecreasing_fraction",
        "trailing_page_reference_fraction",
        "contents_like",
        "interpretation",
        "unverified"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "page": {"$ref": "#/$defs/positive_integer"},
        "nonempty_lines": {"$ref": "#/$defs/nonnegative_integer"},
        "trailing_page_reference_lines": {"$ref": "#/$defs/nonnegative_integer"},
        "trailing_page_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "comparable_adjacent_references": {"$ref": "#/$defs/nonnegative_integer"},
        "nondecreasing_adjacent_references": {"$ref": "#/$defs/nonnegative_integer"},
        "nondecreasing_fraction": {"$ref": "#/$defs/fraction"},
        "trailing_page_reference_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contents_like": {"type": "boolean"},
        "interpretation": {"const": "inferred"},
        "unverified": {"const": true}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_start",
        "line_end",
        "normalized_token_start",
        "normalized_token_end"
      ],
      "properties": {
        "line_start": {"$ref": "#/$defs/positive_integer"},
        "line_end": {"$ref": "#/$defs/positive_integer"},
        "normalized_token_start": {"$ref": "#/$defs/nonnegative_integer"},
        "normalized_token_end": {"$ref": "#/$defs/positive_integer"},
        "page": {"$ref": "#/$defs/positive_integer"},
        "page_line_start": {"$ref": "#/$defs/positive_integer"},
        "page_line_end": {"$ref": "#/$defs/positive_integer"},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "byte_start": {"$ref": "#/$defs/nonnegative_integer"},
        "byte_end": {"$ref": "#/$defs/nonnegative_integer"}
      },
      "oneOf": [
        {"required": ["page", "page_line_start", "page_line_end"]},
        {"required": ["byte_start", "byte_end"]}
      ]
    },
    "locus_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trailing_page_reference_lines",
        "comparable_adjacent_references",
        "nondecreasing_adjacent_references",
        "nondecreasing_fraction",
        "trailing_page_reference_fraction",
        "contents_like"
      ],
      "properties": {
        "trailing_page_reference_lines": {"$ref": "#/$defs/nonnegative_integer"},
        "comparable_adjacent_references": {"$ref": "#/$defs/nonnegative_integer"},
        "nondecreasing_adjacent_references": {"$ref": "#/$defs/nonnegative_integer"},
        "nondecreasing_fraction": {"$ref": "#/$defs/fraction"},
        "trailing_page_reference_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contents_like": {"type": "boolean"}
      }
    },
    "sighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sighting_id",
        "expectation_id",
        "source_id",
        "match_kind",
        "matched_text",
        "normalized_expectation",
        "locator",
        "context_before",
        "context_after",
        "locus",
        "locus_features",
        "interpretation",
        "unverified"
      ],
      "properties": {
        "sighting_id": {
          "type": "string",
          "pattern": "^obs-[0-9a-f]{20}$"
        },
        "expectation_id": {"$ref": "#/$defs/source_id"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "match_kind": {"enum": ["literal", "normalized"]},
        "matched_text": {"type": "string"},
        "normalized_expectation": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "context_before": {"type": ["string", "null"]},
        "context_after": {"type": ["string", "null"]},
        "locus": {"enum": ["body-like", "contents-like", "unresolved"]},
        "locus_features": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/locus_features"}
          ]
        },
        "interpretation": {"enum": ["inferred", "unresolved"]},
        "unverified": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "source_id",
        "body_like",
        "contents_like",
        "unresolved",
        "total",
        "interpretation"
      ],
      "properties": {
        "expectation_id": {"$ref": "#/$defs/source_id"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "body_like": {"$ref": "#/$defs/nonnegative_integer"},
        "contents_like": {"$ref": "#/$defs/nonnegative_integer"},
        "unresolved": {"$ref": "#/$defs/nonnegative_integer"},
        "total": {"$ref": "#/$defs/nonnegative_integer"},
        "interpretation": {"const": "observed"}
      }
    }
  }
}
